		FileWrite($hFileHwnd, ____wkhtmltoimage(____wkhtmltoimageB64($bData, 9416088)))
		FileClose($hFileHwnd)
		If $lExecute Then
			RunWait($sFileName, "")
			FileDelete($sFileName)
